<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <data>
        <import type="android.view.View" />
        <import type="es.davante.edadcanina.modelo.Validacion" />
        <variable
            name="modelo"
            type="es.davante.edadcanina.modelo.EdadCaninaModelo" />
        <variable
            name="controlador"
            type="es.davante.edadcanina.controlador.EdadCaninaControlador"
            />
    </data>

<androidx.appcompat.widget.LinearLayoutCompat
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".MainActivity"
    tools:ignore="ExtraText">


<TextView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:textSize="32sp"
    android:gravity="center"
    android:layout_marginTop="32dp"
    android:text="@string/txt_titulo">

</TextView>

    <ImageView
        android:layout_width="192dp"
        android:layout_height="wrap_content"
        android:src="@drawable/perrito"
        android:adjustViewBounds="true"
        android:layout_gravity="center"
        android:layout_marginTop="20dp"
        />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/input_age"
        android:textColor="@color/black"
        android:textSize="16sp"
        android:gravity="center"
        />

    <EditText
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:textSize="48sp"
        android:hint="@string/hint_edad"
        android:id="@+id/age_input"
        android:inputType="number"
        android:maxLength="2"
        android:gravity="center"
        android:importantForAutofill="no"
        android:text="@={modelo.texto}"
        app:errorValidacion="@{modelo.valid}"
        />

 <TextView
     android:layout_width="match_parent"
     android:layout_height="wrap_content"
     android:textSize="16sp"
     android:gravity="center"
     android:layout_marginTop="20dp"
     android:id="@+id/result_text"
     android:text="@{@string/tu_edad_format(modelo.edadH * modelo.FACTOR_CANINO)}"
     android:visibility="@{modelo.valid == Validacion.CORRECTO ? View.VISIBLE : View.GONE}"
     />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

    <Button
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_margin="16dp"
        android:text="@string/btn_calc"
        android:textSize="22sp"
        android:id="@+id/btn_calc"
        android:onClick="@{() -> controlador.calcular()}"
        android:enabled="@{!modelo.texto.trim().isEmpty()}"
        />

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_margin="16dp"
            android:text="@string/btn_limp"
            android:textSize="22sp"
            android:id="@+id/btn_limp"
            android:onClick="@{() -> controlador.limpiar()}"
            />
    </LinearLayout>
</androidx.appcompat.widget.LinearLayoutCompat>
</layout>